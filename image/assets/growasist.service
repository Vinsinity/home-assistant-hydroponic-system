[Unit]
Description=GrowAsist local cultivation service
After=growasist-firstboot.service network.target
Wants=growasist-firstboot.service

[Service]
Type=simple
User=growasist
Group=growasist
SupplementaryGroups=i2c
WorkingDirectory=/opt/growasist/current
Environment=PYTHONPATH=/opt/growasist/current
EnvironmentFile=/etc/growasist/growasist.env
ExecStart=/usr/bin/python3 -m growasist --data-dir /var/lib/growasist serve --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/growasist
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DevicePolicy=closed
DeviceAllow=/dev/i2c-1 rw

[Install]
WantedBy=multi-user.target
